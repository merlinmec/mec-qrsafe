<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mecqrsafe</groupId>
    <artifactId>mec-qrsafe-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>mec-qrsafe</name>
    <description>
        Gerador de QR codes customizaveis com validador de escaneabilidade
        em tempo real e encoder proprio (sem lib pronta). Ver
        DECISOES-E-TRADEOFFS.txt e mec-explain.txt na raiz do projeto.
    </description>

    <!--
        Este pom é o AGREGADOR (lista os módulos do reactor) e também o
        PARENT de qr-engine / qr-validation / qr-render — módulos que NÃO
        podem depender de Spring, nem por acidente. qr-api usa
        spring-boot-starter-parent como parent próprio (ver qr-api/pom.xml)
        em vez de herdar deste — dessa forma, o único jeito de Spring
        aparecer em qr-engine/qr-validation/qr-render seria alguém
        adicionar a dependência manualmente e explicitamente, o que se
        pega fácil em qualquer review.
    -->

    <modules>
        <module>qr-engine</module>
        <module>qr-validation</module>
        <module>qr-render</module>
        <module>qr-api</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <java.version>21</java.version>
        <kotlin.version>2.1.0</kotlin.version>
        <kotlin.compiler.jvmTarget>21</kotlin.compiler.jvmTarget>
        <junit-jupiter.version>5.11.3</junit-jupiter.version>
        <kotest.version>5.9.1</kotest.version>
        <zxing.version>3.5.3</zxing.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                BOM do JUnit primeiro: o kotlin-test-junit5 puxa o JUnit
                5.10 por transitividade, e misturar com o 5.11 do
                junit-jupiter quebra os testes parametrizados (a plataforma
                5.10 não tem o método que o junit-jupiter-params 5.11 chama).
                O BOM fixa a família inteira na mesma versão.
            -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit-jupiter.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-stdlib</artifactId>
                <version>${kotlin.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-test-junit5</artifactId>
                <version>${kotlin.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit-jupiter.version}</version>
                <scope>test</scope>
            </dependency>
            <!-- Módulos internos, versionados juntos no mesmo reactor -->
            <dependency>
                <groupId>com.mecqrsafe</groupId>
                <artifactId>qr-engine</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mecqrsafe</groupId>
                <artifactId>qr-validation</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mecqrsafe</groupId>
                <artifactId>qr-render</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-maven-plugin</artifactId>
                    <version>${kotlin.version}</version>
                    <executions>
                        <execution>
                            <id>compile</id>
                            <goals><goal>compile</goal></goals>
                        </execution>
                        <execution>
                            <id>test-compile</id>
                            <goals><goal>test-compile</goal></goals>
                        </execution>
                    </executions>
                    <configuration>
                        <jvmTarget>${kotlin.compiler.jvmTarget}</jvmTarget>
                        <args>
                            <arg>-Xjsr305=strict</arg>
                        </args>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
