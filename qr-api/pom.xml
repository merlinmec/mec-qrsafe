<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Parent é o spring-boot-starter-parent, DE PROPÓSITO — não o pom
        agregador do reactor (mec-qrsafe-parent). Isso é o que impede
        Spring de vazar por herança para qr-engine/qr-validation/qr-render:
        eles têm o pom agregador como parent (sem Spring nenhum);
        qr-api tem o parent do Spring Boot. qr-api continua fazendo parte
        do build multi-módulo porque está listado em <modules> no pom raiz
        — aggregation e inheritance são coisas independentes em Maven.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.mecqrsafe</groupId>
    <artifactId>qr-api</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>qr-api</name>
    <description>
        Unico modulo com Spring Boot. Orquestra qr-engine + qr-validation +
        qr-render via controllers/DTOs — nao tem regra de negocio de QR
        aqui, so exposicao HTTP.
    </description>

    <properties>
        <java.version>21</java.version>
        <kotlin.version>2.1.0</kotlin.version>
        <mecqrsafe.modules.version>0.1.0-SNAPSHOT</mecqrsafe.modules.version>
        <zxing.version>3.5.3</zxing.version>
    </properties>

    <dependencies>
        <!-- Módulos internos (mesmo reactor) -->
        <dependency>
            <groupId>com.mecqrsafe</groupId>
            <artifactId>qr-engine</artifactId>
            <version>${mecqrsafe.modules.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mecqrsafe</groupId>
            <artifactId>qr-validation</artifactId>
            <version>${mecqrsafe.modules.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mecqrsafe</groupId>
            <artifactId>qr-render</artifactId>
            <version>${mecqrsafe.modules.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--
            Jackson 3 (tools.jackson), o que o Spring Boot 4 usa. O módulo
            do Jackson 2 (com.fasterxml.jackson.module) entra no classpath
            mas o Spring não o registra, e sem o módulo Kotlin os valores
            padrão dos data classes são ignorados: um campo opcional
            omitido no JSON vira null e a requisição quebra.
        -->
        <dependency>
            <groupId>tools.jackson.module</groupId>
            <artifactId>jackson-module-kotlin</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-reflect</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Leitor de QR de verdade, so nos testes: o PNG que o /export
            devolve precisa ler. Versao repetida aqui porque este modulo
            herda do pom do Spring Boot, nao do pom raiz.
        -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>${zxing.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
        <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <configuration>
                    <jvmTarget>${java.version}</jvmTarget>
                    <compilerPlugins>
                        <plugin>spring</plugin>
                    </compilerPlugins>
                </configuration>
                <executions>
                    <execution>
                        <id>compile</id>
                        <goals><goal>compile</goal></goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <goals><goal>test-compile</goal></goals>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-allopen</artifactId>
                        <version>${kotlin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
